# ClickUp Personal API Token
# Get yours in ClickUp: Settings -> Apps -> Generate API Token
CLICKUP_API_TOKEN=pk_your_personal_api_token_here

# Optional Development Profile Overrides
# Role: agnostic (default) | frontend | backend | fullstack
CLICKUP_DEV_ROLE=agnostic

# Framework: generic (default) | angular | react | vue | nestjs | fastapi | express | django | etc.
CLICKUP_FRAMEWORK=generic

# Language: generic (default) | typescript | javascript | python | go | java | csharp | etc.
CLICKUP_LANGUAGE=generic

# Architecture style: clean-architecture (default) | modular | layered
CLICKUP_ARCH_STYLE=clean-architecture
